# Template for a funded TradeLocker account's credentials.
#
# Copy to the gitignored bot_data/ directory -- ONE FILE PER ACCOUNT:
#   cp scripts/tradelocker_env_template.env bot_data/tradelocker_acct1.env
#   cp scripts/tradelocker_env_template.env bot_data/tradelocker_acct2.env
# then fill in each account's values. NEVER commit the filled-in files.
#
# The values come from the prop firm's dashboard after purchase (the
# TradeLocker platform login -- email, password, and the server name
# shown with the credentials).

TRADELOCKER_EMAIL=
TRADELOCKER_PASSWORD=
TRADELOCKER_SERVER=

# Leave commented for the demo environment (ALWAYS start there).
# Uncomment ONLY after the demo run has proven itself and you explicitly
# want this account trading real funds:
# TRADELOCKER_LIVE=1
